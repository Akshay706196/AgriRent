# AgriRent Handover, Return & Late-Fine Microservice Environment Configuration

# Server & Network Configuration
PORT=4005
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database & Storage
SQL_DB_PATH=./data/agrirent_handovers.sqlite
MONGODB_URI=mongodb://127.0.0.1:27017/agrirent_handovers

# Downstream AgriRent Microservices
BOOKING_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4004
IDENTITY_SERVICE_URL=http://localhost:4003
INTERNAL_SERVICE_TOKEN=agrirent_internal_service_token_2026

# Security & PIN Management
JWT_SECRET=agrirent_super_secret_jwt_key_2026_dev
PIN_PEPPER=agrirent_pin_pepper_2026_dev
PIN_TTL_MINUTES=30
MAX_PIN_ATTEMPTS=3
MAX_PIN_GENERATIONS_PER_HOUR=5
DEV_EXPOSE_PIN=true

# Business & Late Fine Calculation Policies
BUSINESS_TIMEZONE=Asia/Kolkata
GRACE_PERIOD_MINUTES=30
LATE_FINE_DAILY_RATE=300000
LATE_FINE_CAP_AT_DEPOSIT=true

# Outbound Resilience (Timeout, Circuit Breaker, Retries)
OUTBOUND_TIMEOUT_MS=5000
MAX_OUTBOUND_RETRIES=2
INITIAL_BACKOFF_MS=200
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
STRICT_RATE_LIMIT_MAX_REQUESTS=20
