<?xml version="1.0" encoding="UTF-8"?>
<definitions name="HandoverService"
             targetNamespace="http://agrirent.internal/handover"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://agrirent.internal/handover"
             xmlns:types="http://agrirent.internal/handover/types"
             xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <types>
    <xs:schema targetNamespace="http://agrirent.internal/handover/types"
               elementFormDefault="qualified">
      <xs:element name="CalculateLateFineRequest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="bookingId" type="xs:string"/>
            <xs:element name="actualReturnTimestamp" type="xs:string" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="CalculateLateFineResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="bookingId" type="xs:string"/>
            <xs:element name="overdueMinutes" type="xs:integer"/>
            <xs:element name="overdueDays" type="xs:integer"/>
            <xs:element name="fineAmount" type="xs:decimal"/>
            <xs:element name="currency" type="xs:string"/>
            <xs:element name="dueDate" type="xs:string" minOccurs="0"/>
            <xs:element name="actualReturn" type="xs:string" minOccurs="0"/>
            <xs:element name="depositCapApplied" type="xs:boolean" minOccurs="0"/>
            <xs:element name="calculatedAt" type="xs:string" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </types>

  <message name="CalculateLateFineInput">
    <part name="parameters" element="types:CalculateLateFineRequest"/>
  </message>

  <message name="CalculateLateFineOutput">
    <part name="parameters" element="types:CalculateLateFineResponse"/>
  </message>

  <portType name="HandoverPortType">
    <operation name="CalculateLateFine">
      <input message="tns:CalculateLateFineInput"/>
      <output message="tns:CalculateLateFineOutput"/>
    </operation>
  </portType>

  <binding name="HandoverSoapBinding" type="tns:HandoverPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="CalculateLateFine">
      <soap:operation soapAction="http://agrirent.internal/handover/CalculateLateFine"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
    </operation>
  </binding>

  <service name="HandoverService">
    <documentation>AgriRent Handover, Return &amp; Late-Fine SOAP Service</documentation>
    <port name="HandoverPort" binding="tns:HandoverSoapBinding">
      <soap:address location="http://localhost:4005/soap/handover"/>
    </port>
  </service>

</definitions>
