PORT=4004
NODE_ENV=development
LOG_LEVEL=info

# SQL Database (SQLite file or :memory: for tests)
SQL_DB_PATH=./data/agrirent_payments.sqlite

# MongoDB NoSQL Document Store (for payment_events and audit logs)
MONGODB_URI=mongodb://127.0.0.1:27017/agrirent_payments

# Gateway Configuration (mock | simulator | razorpay)
PAYMENT_GATEWAY=simulator
GATEWAY_WEBHOOK_SECRET=agrirent_webhook_secret_key_2026_dev
GATEWAY_TIMEOUT_MS=5000
GATEWAY_SIMULATOR_FAIL_RATE=0
GATEWAY_SIMULATOR_SLOW_MS=0
GATEWAY_SIMULATOR_FORCE_5XX=false

# Inter-Service Dependencies & Circuit Breaker
BOOKING_SERVICE_URL=http://localhost:4002
IDENTITY_SERVICE_URL=http://localhost:4003
CLAIMS_SERVICE_URL=http://localhost:4005
INTERNAL_SERVICE_TOKEN=agrirent_internal_service_token_2026

# Outbound HTTP & Circuit Breaker Thresholds
OUTBOUND_TIMEOUT_MS=5000
MAX_OUTBOUND_RETRIES=2
INITIAL_BACKOFF_MS=200
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000

# Auth & Security
JWT_SECRET=agrirent_super_secret_jwt_key_2026_dev
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
STRICT_RATE_LIMIT_MAX_REQUESTS=20
