# AgriRent Web Frontend Configuration

# Service Target URLs (Direct or through Vite dev proxy)
VITE_IDENTITY_SERVICE_URL=http://localhost:4003
VITE_EQUIPMENT_SERVICE_URL=http://localhost:4001
VITE_BOOKING_SERVICE_URL=http://localhost:4002
VITE_PAYMENT_SERVICE_URL=http://localhost:4004
VITE_HANDOVER_SERVICE_URL=http://localhost:4005
VITE_CLAIMS_SERVICE_URL=http://localhost:4006

# Use Vite Dev Proxy to guarantee zero CORS issues in browser
VITE_USE_DEV_PROXY=true

# Mock mode (MSW) switch for offline / mock testing
VITE_USE_MOCKS=false

# App Title & Environment
VITE_APP_NAME="AgriRent"
VITE_DEFAULT_LOCALE="en"
