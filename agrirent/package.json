{
  "name": "agrirent-backend",
  "version": "1.0.0",
  "description": "AgriRent - Peer-to-Peer Agricultural Equipment Rental Microservices Backend",
  "scripts": {
    "install:identity": "npm --prefix identity-kyc-service install",
    "install:equipment": "npm --prefix equipment-service install",
    "install:booking": "npm --prefix booking-service install",
    "install:payment": "npm --prefix payment-service install",
    "install:handover": "npm --prefix handover-service install",
    "install:claims": "npm --prefix claims-service install",
    "install:all": "npm run install:identity && npm run install:equipment && npm run install:booking && npm run install:payment && npm run install:handover && npm run install:claims",
    "test:identity": "npm --prefix identity-kyc-service test",
    "test:equipment": "npm --prefix equipment-service test",
    "test:booking": "npm --prefix booking-service test",
    "test:payment": "npm --prefix payment-service test",
    "test:handover": "npm --prefix handover-service test",
    "test:claims": "npm --prefix claims-service test",
    "test": "npm run test:identity && npm run test:equipment && npm run test:booking && npm run test:payment && npm run test:handover && npm run test:claims",
    "start:identity": "npm --prefix identity-kyc-service start",
    "start:equipment": "npm --prefix equipment-service start",
    "start:booking": "npm --prefix booking-service start",
    "start:payment": "npm --prefix payment-service start",
    "start:handover": "npm --prefix handover-service start",
    "start:claims": "npm --prefix claims-service start",
    "dev:identity": "npm --prefix identity-kyc-service run dev",
    "dev:equipment": "npm --prefix equipment-service run dev",
    "dev:booking": "npm --prefix booking-service run dev",
    "dev:payment": "npm --prefix payment-service run dev",
    "dev:handover": "npm --prefix handover-service run dev",
    "dev:claims": "npm --prefix claims-service run dev",
    "e2e:payment": "node payment-service/scripts/e2e-payment.js",
    "e2e:handover": "node handover-service/scripts/e2e-handover.js",
    "e2e:claims": "node claims-service/scripts/e2e-claims.js"
  },
  "keywords": [
    "agrirent",
    "microservices",
    "soa",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "AgriRent Team",
  "license": "ISC"
}
