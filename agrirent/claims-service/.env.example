PORT=4006
NODE_ENV=development

# SQL Database Configuration (node:sqlite)
SQL_DB_PATH=data/agrirent_claims.sqlite

# MongoDB Configuration (Mongoose)
MONGODB_URI=mongodb://localhost:27017/agrirent_claims

# Upstream Services
BOOKING_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4004
HANDOVER_SERVICE_URL=http://localhost:4005
IDENTITY_SERVICE_URL=http://localhost:4003

# Internal Service & Security
INTERNAL_SERVICE_TOKEN=agrirent_internal_service_token_2026
JWT_SECRET=agrirent_super_secret_jwt_key_2026_dev
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Business Rules & Windows
CLAIM_WINDOW_HOURS=48
DISPUTE_WINDOW_HOURS=72
REVIEW_WINDOW_DAYS=14
EVIDENCE_MAX_PHOTOS=10
DISPUTE_HOLD_POLICY=BLOCK_SETTLEMENT
SETTLEMENT_MAX_ATTEMPTS=3

# Outbound Resilience
OUTBOUND_TIMEOUT_MS=5000
MAX_OUTBOUND_RETRIES=2
INITIAL_BACKOFF_MS=200

# GraphQL Safety Configuration
GRAPHQL_MAX_DEPTH=6
GRAPHQL_MAX_PAGE_SIZE=50
