<?xml version="1.0" encoding="UTF-8"?>
<definitions name="ClaimsService"
             targetNamespace="http://agrirent.internal/claims"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://agrirent.internal/claims"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <types>
    <xsd:schema targetNamespace="http://agrirent.internal/claims" elementFormDefault="qualified">
      <xsd:element name="GetDisputeStatusRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="disputeId" type="xsd:string" minOccurs="1"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetDisputeStatusResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="disputeId" type="xsd:string"/>
            <xsd:element name="claimId" type="xsd:string"/>
            <xsd:element name="status" type="xsd:string"/>
            <xsd:element name="decision" type="xsd:string" minOccurs="0"/>
            <xsd:element name="reason" type="xsd:string" minOccurs="0"/>
            <xsd:element name="resolvedAt" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <message name="GetDisputeStatusInput">
    <part name="parameters" element="tns:GetDisputeStatusRequest"/>
  </message>

  <message name="GetDisputeStatusOutput">
    <part name="parameters" element="tns:GetDisputeStatusResponse"/>
  </message>

  <portType name="ClaimsPortType">
    <operation name="GetDisputeStatus">
      <input message="tns:GetDisputeStatusInput"/>
      <output message="tns:GetDisputeStatusOutput"/>
    </operation>
  </portType>

  <binding name="ClaimsBinding" type="tns:ClaimsPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="GetDisputeStatus">
      <soap:operation soapAction="http://agrirent.internal/claims/GetDisputeStatus"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
    </operation>
  </binding>

  <service name="ClaimsService">
    <documentation>AgriRent Claims and Dispute Resolution SOAP Web Service</documentation>
    <port name="ClaimsPort" binding="tns:ClaimsBinding">
      <soap:address location="http://localhost:4006/soap/claims"/>
    </port>
  </service>

</definitions>
